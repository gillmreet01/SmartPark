# Backend origin for the API + WebSocket.
# Leave EMPTY for local dev (Vite proxies /api and /ws to :8080) and for the
# Docker/nginx setup. Set it for a split cloud deploy where the static frontend
# and the backend live on different domains.
#
# Example:
# VITE_API_BASE=https://smartpark-api.onrender.com
VITE_API_BASE=
